# Database
DATABASE_URL=postgresql://user:password@host:5432/hubble

# Redis
REDIS_URL=redis://user:password@host:6379

# JWT
JWT_SECRET=your-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_live_...
CONNECT_RETURN_URL=https://hubble.app/connect-return
CONNECT_REFRESH_URL=https://hubble.app/connect-refresh

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_PROFILES=hubble-profiles
S3_BUCKET_POSTS=hubble-posts
S3_BUCKET_STORIES=hubble-stories

# App
PORT=4243
NODE_ENV=production
